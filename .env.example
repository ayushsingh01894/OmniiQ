# Copy to .env and edit. NEVER commit .env (it is gitignored).
# These values are for LOCAL DEVELOPMENT only.

# --- PostgreSQL container ---
POSTGRES_USER=omniiq
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=omniiq

# --- Backend ---
# Signs login tokens. Must be >= 32 chars. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The value below is a PLACEHOLDER: replace it, and never reuse it outside local development.
SECRET_KEY=replace-me-with-a-long-random-string-before-first-run
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
LOG_LEVEL=INFO

# Used when you run the backend on your host (not in Docker).
# Inside Docker Compose, the URL is assembled from the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://omniiq:change-me-local-only@localhost:5432/omniiq

# --- Data uploads and background jobs (all optional; shown with their defaults) ---
# MAX_UPLOAD_BYTES=26214400        # 25 MB per upload
# MAX_DATASET_ROWS=500000
# MAX_DATASET_COLUMNS=500
# JOB_BACKEND=inline               # host runs: "inline" needs no Redis. Compose sets "celery".
# REDIS_URL=redis://localhost:6379/0
# STORAGE_ROOT=./storage           # private uploads; gitignored; never serve this folder
